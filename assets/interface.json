{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaXXX",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/MaaXYZ/MaaPracticeBoilerplate",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
                // "./resource_bilibili"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
    {
        "name": "启动-登录签到",
        "entry": "startup_dispatch",
        "doc": "从登录界面一路点到主界面"
    },
    {
        "name": "每日一条龙",
        "entry": "main_dispatch",
        "doc": "从主界面出发，按界面依次把每日内容做完",
        "option": [
            "获取感应",
            "收取资源",
            "办公室",
            "工作间",
            "顿舍",
            "博览厅",
            "茶室"
        ]
    },
    {
        "name": "派遣公司",
        "entry": "main_enter_hub",
        "doc": "从主页进入派遣公司枢纽，按选项把各个小部分做完后自动返回主页",
        "option": [
            "获取感应",
            "收取资源",
            "办公室",
            "工作间",
            "顿舍",
            "博览厅",
            "茶室"
        ]
    }
    ],
    // 派遣公司各小部分的可选开关：默认全部「执行」，在 UI 里改成「跳过」即可跳过该部分。
    // 原理：把该部分的枢纽入口节点 enabled 设为 false。被禁用的节点不会出现在
    // hub_enter 的 next 轮询里（既不识别也不执行），于是整个小部分被整体跳过。
    "option": {
        "获取感应": {
            "cases": [
                { "name": "执行" },
                { "name": "跳过", "pipeline_override": { "hub_collect_sense": { "enabled": false } } }
            ],
            "default_case": "执行"
        },
        "收取资源": {
            "cases": [
                { "name": "执行" },
                { "name": "跳过", "pipeline_override": { "hub_collect_resource": { "enabled": false } } }
            ],
            "default_case": "执行"
        },
        "办公室": {
            "cases": [
                { "name": "执行" },
                { "name": "跳过", "pipeline_override": { "hub_enter_office": { "enabled": false } } }
            ],
            "default_case": "执行"
        },
        "工作间": {
            "cases": [
                { "name": "执行" },
                { "name": "跳过", "pipeline_override": { "hub_enter_workshop": { "enabled": false } } }
            ],
            "default_case": "执行"
        },
        "顿舍": {
            "cases": [
                { "name": "执行" },
                { "name": "跳过", "pipeline_override": { "hub_enter_dorm": { "enabled": false } } }
            ],
            "default_case": "执行"
        },
        "博览厅": {
            "cases": [
                { "name": "执行" },
                { "name": "跳过", "pipeline_override": { "hub_enter_expo": { "enabled": false } } }
            ],
            "default_case": "执行"
        },
        "茶室": {
            "cases": [
                { "name": "执行" },
                { "name": "跳过", "pipeline_override": { "hub_enter_tea_room": { "enabled": false } } }
            ],
            "default_case": "执行"
        }
    }
}